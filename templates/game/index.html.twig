{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
<section style="max-width: 760px; margin: 0 auto;">
    <div class="card" style="padding: 28px;">
        <p style="margin:0 0 8px; color: var(--primary); font-weight:700;">Pulse · Jeux</p>
        <h1 style="margin:0 0 14px;">{{ title }}</h1>

        {% if slug == 'questions-duo' %}
            <p style="color: var(--muted);">
                Jeu duo : répondez à des questions pour apprendre à mieux vous connaître.
            </p>

            <div class="card" style="padding:18px; background: rgba(255,255,255,0.03); margin-top:18px;">
                <strong>Question du moment</strong>
                <p style="margin:12px 0 0; color: var(--muted);">
                    Quel est le souvenir qui te fait toujours sourire ?
                </p>
            </div>

        {% elseif slug == 'cartes-mystere' %}
            <p style="color: var(--muted);">
                Jeu solo : découvre une carte surprise.
            </p>

            <div style="display:flex; justify-content:center; margin-top:24px;">
                <div class="card" style="width:180px; height:240px; display:flex; align-items:center; justify-content:center; background:linear-gradient(135deg, rgba(255,111,174,0.14), rgba(182,140,255,0.12)); font-size:1.2rem; font-weight:700;">
                    Carte Mystère ✨
                </div>
            </div>

        {% elseif slug == 'tu-preferes' %}
            <p style="color: var(--muted);">
                Jeu duo : choisissez entre deux options pour créer de la complicité.
            </p>

            <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:24px;">
                <button class="btn btn-secondary">Ville de nuit</button>
                <button class="btn btn-secondary">Plage au coucher du soleil</button>
            </div>
        {% endif %}

        <div style="margin-top:24px;">
            <a href="{{ path('app_home') }}" class="btn btn-primary">Retour au dashboard</a>
        </div>
    </div>
</section>
{% endblock %}