{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<section style="max-width: 920px; margin: 0 auto;">
    {% for message in app.flashes('success') %}
        <div class="flash-success">{{ message }}</div>
    {% endfor %}

    <div class="card" style="padding: 34px; overflow: hidden;">
        <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:20px; flex-wrap:wrap; margin-bottom:28px;">
            <div>
                <p style="margin:0 0 8px; color: var(--primary); font-weight:700; letter-spacing:0.02em;">
                    Pulse · Mon profil
                </p>
                <h1 style="margin:0 0 10px; font-size: clamp(2rem, 4vw, 3.2rem); line-height:0.95;">
                    Ton identité dans Pulse
                </h1>
                <p style="margin:0; color: var(--muted); max-width: 560px;">
                    Voici la version visible et élégante de ton profil. Tu peux le modifier à tout moment pour affiner ton univers.
                </p>
            </div>

            <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
                Modifier
            </a>
        </div>

        <div style="display:grid; grid-template-columns: 280px 1fr; gap:28px; align-items:start;">
            <aside class="card" style="padding:24px; background: rgba(255,255,255,0.03); text-align:center;">
                <div style="width: 180px; height: 180px; margin: 0 auto 18px; border-radius: 999px; padding: 4px; background: linear-gradient(135deg, rgba(255,111,174,0.9), rgba(182,140,255,0.8)); box-shadow: 0 20px 45px rgba(255,111,174,0.18);">
                    {% if profile.avatar %}
                        <img
                            src="{{ profile.avatar }}"
                            alt="Avatar de {{ profile.pseudo }}"
                            style="width:100%; height:100%; object-fit:cover; border-radius:999px; display:block; border:3px solid rgba(15,11,20,0.95);"
                        >
                    {% else %}
                        <div style="width:100%; height:100%; border-radius:999px; display:flex; align-items:center; justify-content:center; background:rgba(255,255,255,0.05); border:3px solid rgba(15,11,20,0.95); color:var(--muted); font-weight:700; font-size:1.1rem;">
                            Aucun avatar
                        </div>
                    {% endif %}
                </div>

                <h2 style="margin:0 0 6px; font-size: 2rem; line-height: 1;">
                    {{ profile.pseudo ?: 'Profil utilisateur' }}
                </h2>

                <p style="margin:0 0 14px; color: var(--muted);">
                    {{ profile.firstname ?: 'Prénom non renseigné' }}
                </p>

                <div style="display:flex; justify-content:center; gap:10px; flex-wrap:wrap; margin-bottom:14px;">
                    {% if profile.age %}
                        <span style="padding:10px 14px; border-radius:999px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.12); font-weight:600;">
                            {{ profile.age }} ans
                        </span>
                    {% endif %}

                    {% if profile.vibe %}
                        <span style="padding:10px 14px; border-radius:999px; background:linear-gradient(135deg, rgba(255,111,174,0.16), rgba(182,140,255,0.14)); border:1px solid rgba(255,111,174,0.28); color:#ffe4f0; font-weight:700;">
                            {{ profile.vibe }}
                        </span>
                    {% endif %}
                </div>

                <div style="padding-top:16px; border-top:1px solid rgba(255,255,255,0.08); color:var(--muted); font-size:0.95rem;">
                    Profil prêt à matcher ✨
                </div>
            </aside>

            <div style="display:grid; gap:18px;">
                <div class="card" style="padding:22px; background: rgba(255,255,255,0.03);">
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom:10px;">
                        <strong style="font-size:1.05rem;">Bio</strong>
                        <span style="font-size:0.9rem; color:var(--muted);">Ce que les autres ressentent de toi</span>
                    </div>

                    <p style="margin:0; color: var(--muted); white-space: pre-line; line-height:1.8;">
                        {{ profile.bio ?: 'Aucune bio renseignée pour le moment.' }}
                    </p>
                </div>

                <div class="card" style="padding:22px; background: rgba(255,255,255,0.03);">
                    <div style="display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; margin-bottom:14px;">
                        <strong style="font-size:1.05rem;">Centres d’intérêt</strong>
                        <span style="font-size:0.9rem; color:var(--muted);">Tes univers et tes affinités</span>
                    </div>

                    {% if profile.interests and profile.interests|length > 0 %}
                        <div style="display:flex; gap:12px; flex-wrap:wrap;">
                            {% for interest in profile.interests %}
                                <span
                                    style="
                                        display:inline-flex;
                                        align-items:center;
                                        gap:8px;
                                        padding:10px 14px;
                                        border-radius:999px;
                                        background:rgba(255,255,255,0.06);
                                        border:1px solid rgba(255,255,255,0.12);
                                        color:var(--text);
                                        font-weight:600;
                                        box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
                                    "
                                >
                                    ✦ {{ interest }}
                                </span>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p style="margin:0; color: var(--muted);">
                            Aucun centre d’intérêt renseigné.
                        </p>
                    {% endif %}
                </div>

                <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap:18px;">
                    <div class="card" style="padding:22px; background: rgba(255,255,255,0.03);">
                        <strong style="display:block; margin-bottom:8px;">Prénom</strong>
                        <p style="margin:0; color: var(--muted);">
                            {{ profile.firstname ?: 'Non renseigné' }}
                        </p>
                    </div>

                    <div class="card" style="padding:22px; background: rgba(255,255,255,0.03);">
                        <strong style="display:block; margin-bottom:8px;">Énergie</strong>
                        <p style="margin:0; color: var(--muted);">
                            {{ profile.vibe ?: 'Non renseignée' }}
                        </p>
                    </div>
                </div>

                <div class="card" style="padding:22px; background: linear-gradient(135deg, rgba(255,111,174,0.08), rgba(182,140,255,0.08)); border:1px solid rgba(255,111,174,0.16);">
                    <div style="display:flex; justify-content:space-between; gap:16px; align-items:center; flex-wrap:wrap;">
                        <div>
                            <strong style="display:block; margin-bottom:8px; font-size:1.05rem;">Ton profil est prêt</strong>
                            <p style="margin:0; color: var(--muted);">
                                Tu peux maintenant envoyer des crushs, matcher et débloquer des discussions.
                            </p>
                        </div>

                        <div style="display:flex; gap:12px; flex-wrap:wrap;">
                            <a href="{{ path('app_crush_new') }}" class="btn btn-primary">Trouver un crush</a>
                            <a href="{{ path('app_home') }}" class="btn btn-secondary">Retour à l’accueil</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    @media (max-width: 900px) {
        div[style*="grid-template-columns: 280px 1fr"] {
            grid-template-columns: 1fr !important;
        }

        div[style*="grid-template-columns: repeat(2, 1fr)"] {
            grid-template-columns: 1fr !important;
        }
    }
</style>
{% endblock %}