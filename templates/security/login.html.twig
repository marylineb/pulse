{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<section style="max-width: 520px; margin: 0 auto;">
    <div class="card" style="padding: 28px;">

        <div style="margin-bottom: 24px;">
            <p style="margin:0 0 8px; color: var(--primary); font-weight:700;">
                Pulse · Connexion
            </p>
            <h1 style="margin:0 0 10px;">Bienvenue</h1>
            <p style="margin:0; color: var(--muted);">
                Continue ton expérience.
            </p>
        </div>

        {% if error %}
            <div style="margin-bottom:16px; padding:12px; border-radius:12px; background:rgba(255,0,100,0.1); border:1px solid rgba(255,0,100,0.3);">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div class="form-row">
                <label for="inputEmail">Email</label>
                <input
                    type="email"
                    value="{{ last_username }}"
                    name="email"
                    id="inputEmail"
                    required
                    autofocus
                >
            </div>

            <div class="form-row">
                <label for="inputPassword">Mot de passe</label>
                <input
                    type="password"
                    name="password"
                    id="inputPassword"
                    required
                >
            </div>

            <div class="form-row" style="display:flex; align-items:center; gap:10px;">
                <input type="checkbox" name="_remember_me" id="remember_me" style="width:auto;">
                <label for="remember_me" style="margin:0;">Se souvenir de moi</label>
            </div>

            <button class="btn btn-primary" type="submit">
                Se connecter
            </button>
        </form>

        <p style="margin-top: 18px; color: var(--muted);">
            Pas encore de compte ?
            <a href="{{ path('app_register') }}" style="color: var(--primary); font-weight:600;">
                S'inscrire
            </a>
        </p>

    </div>
</section>
{% endblock %}